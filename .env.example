# Audiobookshelf
ABS_URL=http://audiobookshelf:13378
# User API token: ABS web UI -> Settings -> Users -> your user -> API token
ABS_TOKEN=
# Optional comma-separated library IDs to scan. Empty = all libraries.
ABS_LIBRARY_IDS=

# Calibre (directory is mounted at /calibre in docker-compose.yml)
CALIBRE_LIBRARY_DIR=/calibre
# Identity used when this service writes positions into Calibre
CALIBRE_USER=local
CALIBRE_DEVICE=local

# both | abs_to_calibre | calibre_to_abs
SYNC_MODE=both
SYNC_INTERVAL_SECONDS=300
# true = log what would change, write nothing
DRY_RUN=true

HTTP_PORT=8080
LOG_LEVEL=INFO
